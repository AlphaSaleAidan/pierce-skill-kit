#!/bin/sh
# skill-add: install skills with `npx skills add ...`, then refresh the skill router so the new ones are routed.
#   skill-add <owner/repo> [--skill name ...]     same arguments as `npx skills add`
[ $# -gt 0 ] || { sed -n 2,3p "$0"; exit 2; }
command -v npx >/dev/null || { echo "skill-add: needs Node (npx)" >&2; exit 1; }
npx -y skills add "$@" || exit $?
exec "$(dirname "$0")/skill-route-sync"
