# lk-config - sourced by every Pierce Skill Kit tool: loads your config, fills in defaults.
# shellcheck shell=sh disable=SC1090,SC2034  # the config path is chosen at run time; the tools use LK_LEAD
[ -f "${LK_CONFIG:-$HOME/.config/pierce-skill-kit/config}" ] && . "${LK_CONFIG:-$HOME/.config/pierce-skill-kit/config}"
: "${LK_HOME:=$HOME/.pierce-skill-kit}" "${LK_HUB:=hub}" "${LK_LEAD_WINDOW:=Lead}" "${LK_LEAD_DIR:=$HOME/lead}"
: "${LK_CLAUDE:=claude}" "${LK_IDLE_MIN:=60}" "${LK_WATCH_IGNORE:=auto mode|bypass permissions|accept edits}"
: "${LK_SWEEP_IDLE_MIN:=30}" "${LK_CHECK:=auto}" "${LK_CHECK_MODEL:=typesafe/jev-1.13}" "${LK_CHECK_KEY_FILE:=$HOME/.secrets/openrouter.env}"
: "${LK_JOB_TRIES:=3}" "${LK_JOB_RETRY_MIN:=5}" "${LK_JOB_LIMIT_WAIT_MIN:=60}" "${LK_JOB_LIMIT_PAD_S:=300}"
: "${LK_SAY_IDLE_S:=20}" "${LK_SAY_WAIT_MIN:=360}" "${LK_SAY_POLL_S:=5}" "${LK_LEAD_DTACH:=0}"
: "${LK_SAY_PROMPTS:=Paste code|Esc to cancel|Do you want|Enter to confirm|Select (login|account)|Login method}"
: "${LK_HEAVY_SLOTS:=2}" "${LK_HEAVY_NICE:=15}" "${LK_MIN_FREE_MB:=4096}"
LK_LEAD="$LK_HUB:$LK_LEAD_WINDOW"
: "${LK_LEAD_SOCK:=$LK_HOME/lead.sock}"
mkdir -p "$LK_HOME/briefs"
