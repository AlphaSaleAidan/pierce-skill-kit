#!/bin/sh
# secret-in - put a key into your secrets folder WITHOUT it ever appearing in a chat or terminal log.
# Copy the key, then run (in your own terminal, not through Claude):   secret-in <file> [VAR]
# It reads the clipboard (macOS pbpaste, Wayland wl-paste, X11 xclip/xsel), or a hidden prompt with --prompt,
# writes $LK_SECRETS/<file> (chmod 600, folder 700; "VAR=value" if VAR is given), clears the clipboard, and prints
# only the path and the length. Claude then uses the PATH. Never paste a key into a chat; never ask for one there.
. "$(dirname "$0")/lk-config"
dir=${LK_SECRETS:-$HOME/.secrets}; prompt=0
[ "$1" = --prompt ] && { prompt=1; shift; }
f=$1; var=$2
[ -n "$f" ] || { sed -n 3,6p "$0"; exit 2; }
case $f in */*|.*) echo "secret-in: give a plain file name, e.g. stripe.env" >&2; exit 2;; esac
[ -n "$var" ] && { printf '%s' "$var" | grep -qE '^[A-Za-z_][A-Za-z0-9_]*$' || { echo "secret-in: bad variable name" >&2; exit 2; }; }
if [ $prompt = 1 ]; then
  printf 'paste the key (hidden), then Enter: ' >&2; stty -echo 2>/dev/null; IFS= read -r v; stty echo 2>/dev/null; echo >&2
else
  for c in pbpaste "wl-paste -n" "xclip -o -selection clipboard" "xsel -b -o"; do
    command -v "${c%% *}" >/dev/null 2>&1 && { v=$($c 2>/dev/null); clip=$c; break; }; done
  [ -n "$clip" ] || { echo "secret-in: no clipboard tool found; use secret-in --prompt $f${var:+ $var}" >&2; exit 2; }
fi
v=$(printf '%s' "$v" | tr -d '\r' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
[ -n "$v" ] || { echo "secret-in: nothing to save (empty clipboard/input)" >&2; exit 1; }
[ "$(printf '%s\n' "$v" | wc -l)" -le 1 ] || { echo "secret-in: that is more than one line; copy just the key" >&2; exit 1; }
umask 077; mkdir -p "$dir"; chmod 700 "$dir"
[ -f "$dir/$f" ] && cp "$dir/$f" "$dir/$f.bak"
if [ -n "$var" ]; then printf '%s=%s\n' "$var" "$v" > "$dir/$f"; else printf '%s\n' "$v" > "$dir/$f"; fi
chmod 600 "$dir/$f"
case $clip in pbpaste) printf '' | pbcopy 2>/dev/null;; wl-paste*) wl-copy --clear 2>/dev/null;;
  xclip*) printf '' | xclip -selection clipboard 2>/dev/null;; xsel*) xsel -b -c 2>/dev/null;; esac
echo "saved $dir/$f (${#v} characters${var:+, as $var=...}). Give Claude the path, never the value."
