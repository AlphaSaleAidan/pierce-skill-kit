# Pierce Skill Kit config. install.sh copies this to ~/.config/pierce-skill-kit/config.
# Every tool sources it. Point LK_CONFIG at another file to use a different setup (handy for tests).

# Where reports, orders, briefs and watchdog state live.
LK_HOME="$HOME/.pierce-skill-kit"

# tmux session that holds the lead + every project tab, and the lead's window name.
LK_HUB=hub
LK_LEAD_WINDOW=Lead

# Folder the lead session starts in: its own folder (install.sh puts the lead's CLAUDE.md here), never a project
# repo and never $HOME itself (every Claude started under $HOME would read the lead's instructions).
LK_LEAD_DIR="$HOME/lead"

# Command that starts Claude Code. Swap in your own wrapper if you have one.
LK_CLAUDE=claude

# Watchdog: flag a tab idle 2 checks in a row with no report in this many minutes.
LK_IDLE_MIN=60
# Lines matching this regex are ignored when deciding if a tab changed
# (put anything here that ticks on its own, e.g. a clock in your status line).
LK_WATCH_IGNORE='auto mode|bypass permissions|accept edits'

# Model lead-daily --summary uses (a mid model is plenty for a digest).
LK_SUMMARY_MODEL=sonnet

# tab-sweep: close a tab whose last report is done (and is saved, not serving anything) once quiet this long.
LK_SWEEP_IDLE_MIN=30

# report-check: a cheap second look at every report before the lead relays it.
# auto = Jev via OpenRouter when the key file below holds OPENROUTER_API_KEY=... (about $0.00002 a report),
# otherwise Haiku through Claude Code, otherwise free rules. Or force one: jev | haiku | rules | off
LK_CHECK=auto
LK_CHECK_MODEL=typesafe/jev-1.13
LK_CHECK_KEY_FILE="$HOME/.secrets/openrouter.env"

# job: headless jobs under a watchdog. Tries before giving up, minutes between tries, and how long to wait after
# a usage limit when the message has no reset time.
LK_JOB_TRIES=3
LK_JOB_RETRY_MIN=5
LK_JOB_LIMIT_WAIT_MIN=60

# lead-round: files that must keep getting fresh output ("path:max_minutes", space-separated), e.g.
# LK_HEARTBEATS="$HOME/backups/last-run.log:1500 $HOME/site/uptime.txt:30"
LK_HEARTBEATS=''

# heavy: box-wide queue for CPU-heavy commands.
LK_HEAVY_SLOTS=2
LK_HEAVY_NICE=15
# RAM guard: heavy jobs wait while free memory is below this (MB).
LK_MIN_FREE_MB=4096

# --- brain-loop mod only (mods/brain-loop). Every path defaults under LK_HOME; leave a line out to keep the default. ---
# The Obsidian-compatible vault it writes (open this folder in Obsidian, or run: brain-loop page).
BRAIN_VAULT="$LK_HOME/brain"
# Projects and people to link notes to (copy examples/brain-loop-inputs/entities.json and edit it).
BRAIN_ENTITIES="$LK_HOME/brain-entities.json"
# Where plan files live (tab-plan skill): $BRAIN_PLANS/<project>/MMDD-<task>.md
BRAIN_PLANS="$LK_HOME/plans"
# Colon-separated Claude memory folders to turn into notes (feedback files become rules). Empty = none.
BRAIN_MEMORY_DIRS=''
# Optional money ledger TSV: id added direction(in|out) who what amount due status project note. Empty = no money notes.
BRAIN_LEDGER=''
# Router + plan-grade state, logs, the OFF switch and the Jev spend log.
BRAIN_ROUTER_DIR="$LK_HOME/brain-loop"
# Jev for the router (--engine jev|hybrid) and plan-grade: closed until you set a monthly dollar cap here.
# Uses LK_CHECK_KEY_FILE + LK_CHECK_MODEL above. Measured about $0.00004 a report.
BRAIN_JEV_CAP_USD=0
# What notes call the human (default: owner).
BRAIN_OWNER=owner

# --- macOS helpers only (bin/macos). Leave empty if you don't use a Mac terminal. ---
# How the server reaches your Mac (usually a reverse SSH tunnel you opened from the Mac).
LK_MAC_SSH=''            # e.g. 'ssh -p 2222 -o BatchMode=yes -o ConnectTimeout=6 me@localhost'
# How your Mac reaches the server (used inside the Terminal.app tabs it opens).
LK_BOX_SSH=''            # e.g. 'ssh -t me@my-server'
